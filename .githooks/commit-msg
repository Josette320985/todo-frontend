#!/bin/sh
# commit-msg hook: enforces the Team 3 commit rules (docs/CONTRIBUTING.md).
#   1. The header follows Conventional Commits and is at most 72 characters.
#   2. A commit that changes code also changes documentation (docs/ or *.md),
#      unless the message has a "Docs-Exempt: <reason>" trailer.
# Enable it once per clone:  git config core.hooksPath .githooks

msg_file="$1"
root=$(git rev-parse --show-toplevel)
code_paths="$root/.githooks/code-paths"

fail() {
    printf 'commit-msg: %s\n' "$1" >&2
    printf 'See docs/CONTRIBUTING.md for the commit rules.\n' >&2
    exit 1
}

# First non-comment line of the message is the header.
header=$(grep -v '^#' "$msg_file" | sed -n '1p' | tr -d '\r')

# Messages generated by Git itself are not checked.
case "$header" in
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# Rule 1: Conventional Commits header.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].*'
if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
    fail "header must look like 'type(scope): summary', got: '$header'"
fi
if [ "${#header}" -gt 72 ]; then
    fail "header is ${#header} characters long, the limit is 72"
fi

# Rule 2: no code without documentation.
[ -f "$code_paths" ] || exit 0
staged=$(git diff --cached --name-only)
code=$(printf '%s\n' "$staged" | grep -E -f "$code_paths")
[ -n "$code" ] || exit 0

docs=$(printf '%s\n' "$staged" | grep -E '(^docs/|\.md$)')
[ -n "$docs" ] && exit 0

if grep -Eq '^Docs-Exempt: *[^ ]' "$msg_file"; then
    exit 0
fi

printf 'commit-msg: these code files changed without documentation:\n' >&2
printf '%s\n' "$code" | sed 's/^/  - /' >&2
fail "stage a docs/ or *.md change (for example docs/CHANGELOG.md), or add a 'Docs-Exempt: <reason>' trailer"
